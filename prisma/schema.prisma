generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum TipoPessoa {
  SOLICITANTE
  TECNICO
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum Situacao {
  ABERTO
  EM_ATENDIMENTO
  RESOLVIDO
  FECHADO
  CANCELADO
}

model Pessoa {
  id                  Int          @id @default(autoincrement())
  nome                String
  email               String       @unique
  tipo                TipoPessoa
  ativo               Boolean      @default(true)
  chamadosSolicitados Chamado[]    @relation("Solicitante")
  chamadosAtendidos   Chamado[]    @relation("Tecnico")
  comentarios         Comentario[]
}

model TipoProblema {
  id       Int       @id @default(autoincrement())
  nome     String    @unique
  ativo    Boolean   @default(true)
  chamados Chamado[]
}

model Chamado {
  id             Int          @id @default(autoincrement())
  titulo         String       @db.VarChar(100)
  descricao      String       @db.Text
  prioridade     Prioridade   @default(MEDIA)
  situacao       Situacao     @default(ABERTO)
  criadoEm       DateTime     @default(now())
  resolvidoEm    DateTime?
  solicitanteId  Int
  solicitante    Pessoa       @relation("Solicitante", fields: [solicitanteId], references: [id])
  tecnicoId      Int?
  tecnico        Pessoa?      @relation("Tecnico", fields: [tecnicoId], references: [id])
  tipoProblemaId Int
  tipoProblema   TipoProblema @relation(fields: [tipoProblemaId], references: [id])
  comentarios    Comentario[]
}

model Comentario {
  id        Int      @id @default(autoincrement())
  texto     String   @db.Text
  criadoEm  DateTime @default(now())
  chamadoId Int
  chamado   Chamado  @relation(fields: [chamadoId], references: [id])
  autorId   Int
  autor     Pessoa   @relation(fields: [autorId], references: [id])
}
